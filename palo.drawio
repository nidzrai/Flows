quot;&gt;.vnic_type = baremetal&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;one trunk Trunk_1                    &lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191);&quot;&gt;Trunk_1&lt;/span&gt;.port_id = &lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191);&quot;&gt;anchor_&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 190, 191);&quot;&gt;P&lt;/span&gt;.id&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;three subports on Trunk             G, I1, I2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;one provider-created VIF        &lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191); background-color: rgb(255, 255, 255);&quot;&gt;anchor_&lt;/span&gt;&lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191); background-color: rgb(255, 255, 255);&quot;&gt;P&lt;/span&gt;.id appears in &lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191);&quot;&gt;ironic_node_1&lt;/span&gt;&#39;s VIF list&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;caret-color: rgb(187, 190, 191); color: rgb(187, 190, 191);&quot;&gt;Trunk_1&lt;/span&gt;.sub_ports:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;  G  -&amp;gt; external network       trunk tag 200&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;  I1 -&amp;gt; internal network A     first allowed unused tag &amp;gt;= 201&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;  I2 -&amp;gt; internal network B     next allo
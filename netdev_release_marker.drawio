<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="IhNJuHvfsLdsrPWyL8B2">
    <mxGraphModel dx="3325" dy="1805" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph LIFE[\&quot;Normal lifecycle\&quot;]\n        EN[\&quot;enroll-fw&lt;br/&gt;driver = paloalto\&quot;] --&gt; AV[\&quot;available&lt;br/&gt;no identity, no markers\&quot;]\n        AV --&gt; SEL[\&quot;router create selects:&lt;br/&gt;driver + resource_class&lt;br/&gt;+ available + not maintenance&lt;br/&gt;+ no identity, no markers\&quot;]\n        SEL --&gt; MG[\&quot;manage → manageable\&quot;]\n        MG --&gt; ST[\&quot;stamp instance_uuid,&lt;br/&gt;lessee, instance_name\&quot;]\n        ST --&gt; AD[\&quot;adopt → active\&quot;]\n        AD --&gt; ROW[\&quot;Neutron commits the router row\&quot;]\n        ROW --&gt; LIVE[\&quot;active, serving a live router\&quot;]\n        LIVE --&gt; DEL[\&quot;router deleted\&quot;]\n    end\n\n    ST -. \&quot;adopt fails\&quot; .-&gt; CALL\n    DEL --&gt; CALL\n    RECHK --&gt;|absent| CALL\n    CALL[\&quot;release(node, router_id)\&quot;]\n\n    AD -. \&quot;router row never commits\&quot; .-&gt; ORPH\n    CALL -. \&quot;fails after the marker is written —&lt;br/&gt;AFTER_DELETE swallows the error\&quot; .-&gt; ORPH\n    ORPH[\&quot;ORPHAN&lt;br/&gt;identity or marker present,&lt;br/&gt;router absent\&quot;]\n\n    subgraph RELEASE[\&quot;release() — shared by rollback, router delete, and the periodic\&quot;]\n        CALL --&gt; G1{\&quot;still paloalto&lt;br/&gt;and not maintenance?\&quot;}\n        G1 --&gt;|no| X1[\&quot;stop — not ours to touch\&quot;]\n        G1 --&gt;|yes| G2{\&quot;identity still&lt;br/&gt;matches this router?\&quot;}\n        G2 --&gt;|no| X2[\&quot;stop — belongs to someone else\&quot;]\n        G2 --&gt;|yes| G3{\&quot;state has a&lt;br/&gt;known verb?\&quot;}\n        G3 --&gt;|no| X3[\&quot;defer, log for an operator\&quot;]\n        G3 --&gt;|yes| WM[\&quot;WRITE MARKER&lt;br/&gt;extra.understack_router_release&lt;br/&gt;= router_id\&quot;]\n        WM --&gt; RR1[\&quot;re-read + verify&lt;br/&gt;still ours, state unmoved\&quot;]\n        RR1 --&gt;|mismatch| X4[\&quot;stop — retried next pass\&quot;]\n        RR1 --&gt; DISP{\&quot;provision_state\&quot;}\n        DISP --&gt;|\&quot;active / error\&quot;| UND[\&quot;undeploy → available\&quot;]\n        DISP --&gt;|\&quot;adopt failed /&lt;br/&gt;clean failed\&quot;| MAN[\&quot;manage → manageable\&quot;]\n        DISP --&gt;|\&quot;manageable\&quot;| SKIP[\&quot;no transition\&quot;]\n        DISP --&gt;|\&quot;available\&quot;| SKIP\n        UND --&gt; RR2[\&quot;re-read + verify\&quot;]\n        MAN --&gt; RR2\n        SKIP --&gt; RR2\n        RR2 --&gt;|\&quot;not at final state\&quot;| X5[\&quot;stop — marker persists\&quot;]\n        RR2 --&gt; CLR[\&quot;ONE PATCH:&lt;br/&gt;clear lessee, instance_uuid,&lt;br/&gt;instance_name&lt;br/&gt;+ REMOVE MARKER\&quot;]\n        CLR --&gt; OK{\&quot;re-read: fully clean?\&quot;}\n        OK --&gt;|no| X6[\&quot;stop — marker persists\&quot;]\n        OK --&gt;|yes| DONE[\&quot;complete\&quot;]\n    end\n\n    DONE --&gt; POOL{\&quot;parked?\&quot;}\n    POOL --&gt;|\&quot;no — reached available\&quot;| AV\n    POOL --&gt;|\&quot;yes — adopt/clean failed&lt;br/&gt;or was manageable\&quot;| PARK[\&quot;parked in manageable,&lt;br/&gt;identity cleared\&quot;]\n    PARK --&gt; OPS[\&quot;operator inspects,&lt;br/&gt;then node provide\&quot;]\n    OPS --&gt; AV\n\n    X4 -.-&gt; ORPH\n    X5 -.-&gt; ORPH\n    X6 -.-&gt; ORPH\n\n    subgraph PASS[\&quot;One pass — every 600s, on the OVN lock holder only\&quot;]\n        ALL[\&quot;all Ironic nodes\&quot;] --&gt; FILT{\&quot;driver = paloalto&lt;br/&gt;AND not maintenance?\&quot;}\n        FILT --&gt;|no| NEVER[\&quot;never returned&lt;br/&gt;netdev nodes, parked nodes\&quot;]\n        FILT --&gt;|yes| CAND{\&quot;instance_uuid&lt;br/&gt;OR release marker?\&quot;}\n        CAND --&gt;|neither| NOTC[\&quot;not a candidate\&quot;]\n        CAND --&gt;|yes| OWN{\&quot;identities agree?\&quot;}\n        OWN --&gt;|conflicting| IGN[\&quot;ignored\&quot;]\n        OWN --&gt;|yes| NEU{\&quot;router exists&lt;br/&gt;in Neutron?\&quot;}\n        NEU --&gt;|yes| LEAVE[\&quot;left alone\&quot;]\n        NEU --&gt;|no| SEEN{\&quot;same node+router&lt;br/&gt;seen last pass?\&quot;}\n        SEEN --&gt;|no| DEFER[\&quot;record sighting,&lt;br/&gt;defer to next pass\&quot;]\n        SEEN --&gt;|yes| RECHK{\&quot;router still absent?\&quot;}\n        RECHK --&gt;|reappeared| DISARM[\&quot;drop the sighting\&quot;]\n    end\n\n    ORPH --&gt; ALL\n    DEFER -. \&quot;next pass\&quot; .-&gt; ALL\n    X3 -. \&quot;sighting kept —&lt;br/&gt;retried next pass\&quot; .-&gt; ALL&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="M4QifHk4MXvPPk1OoIYL-1">
